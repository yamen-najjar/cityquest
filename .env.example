# Phase 1 needs none of these: the prototype runs with no external service.
# Copy to .env.local when a later phase starts. Never commit real values.

# Public base URL, used for the sitemap, canonical links and Open Graph (Phase 1 falls back to localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2 - Supabase (database, auth). The service-role key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 - Stripe Checkout. Purchases are fulfilled only from the verified webhook, never from the redirect.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Phase 4 - MapLibre tile provider (for example MapTiler). Restrict the key to your domain.
NEXT_PUBLIC_MAP_STYLE_URL=
