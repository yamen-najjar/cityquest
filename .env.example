# Copy to .env.local and fill in. Never commit real values. The site still boots with the Supabase values
# unset (accounts and sync simply switch off); for local dev, `supabase start` prints the values to use.

# Public base URL, used for the sitemap, canonical links and Open Graph (falls back to localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2 - Supabase (database, auth). Needed for accounts and cross-device progress sync. Without them the
# app runs signed-out and offline-only. The service-role key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 - Stripe Checkout. Purchases are fulfilled only from the verified webhook, never from the redirect.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Phase 4 - MapLibre tile provider (for example MapTiler). Restrict the key to your domain.
NEXT_PUBLIC_MAP_STYLE_URL=
